# Mojo
*.mojopkg
__pycache__/

# Build artifacts (root level only, not conformance/lib/)
/lib/
/target/
*.so
*.dylib

# Python
.venv/
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Downloaded test vectors
conformance/vectors/hpack-stories/

# Internal docs — kept local, not committed
specs/
plans/
research/
docs/project-context.md
docs/superpowers/
docs/plans/

# Test certificates (regenerated by scripts/gen_test_certs.sh)
examples/reverse_proxy/certs/
certs/

# Local research workspace — TQUIC source tree, vendor reads, scratch notes.
# Useful per `feedback_read_tquic_source_first.md` but never committed (3rd-party
# source bloats history). Repopulate via `git clone` into .research/ if needed.
.research/

# Worktree-local symlink to repo-root HttpArena fixtures
bench/.httparena

# Git worktrees
.worktrees/

# Claude Code session state (multi-GB local)
.claude/

# mojox cache
.mojox/

# Bench evidence artifacts (regenerable from PROFILE_ACCEPT=True + perf-record).
# Keep only the cumulative reference table; raw sidecars, verdict docs, and
# baselines live locally.
bench/quic_perf/results/*
!bench/quic_perf/results/.gitkeep
!bench/quic_perf/results/REFERENCE.md
bench/quic_perf/logs/

# Older H2 perf phase artifacts (flamegraphs, hotspot tables, audits)
bench/profile/

# Env files (LD_LIBRARY_PATH etc — set via direnv/shell, not committed)
.env
CLAUDE.md
bench/h1_server
bench/h2_server
bench/h3_server
bench/launcher

# Legacy `mojo build -o main` outputs at example root. Each example's
# binary is now produced into its own .venv/bin/<name> by `uv sync` via
# the mojox-build `binaries` config; the root-level ELF is obsolete.
examples/*/main
examples/*/dist/
# `conformance/scripts/run_h3i.sh` extracts the example's wheel binary
# back to the example root for direct exec; never commit.
examples/hello_h3_server/hello_h3_server

# h3spec binary — downloaded on demand by conformance/scripts/run_h3spec.sh;
# pinned via conformance/vendor/h3spec/SHA256SUMS (binary itself not committed).
conformance/vendor/h3spec/h3spec
