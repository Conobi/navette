# Persistent-connection scenario: many requests per QUIC connection.
# Stresses steady-state stack throughput, not handshake.
MAX_REQUESTS_PER_CONN=0
MAX_CONCURRENT_REQUESTS=10
H2LOAD_M=10
# P2: TLS 1.3 session resumption ticket-store (Plan: 2026-05-03).
# Long-conn re-uses one connection so resumption is rarely exercised here;
# included for symmetry + future regression detection.
SESSION_FILE=/tmp/tquic-session-longconn.bin
