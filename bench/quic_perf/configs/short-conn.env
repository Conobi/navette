# Short-connection scenario: 1 request per QUIC connection.
# Stresses handshake throughput, not steady-state.
MAX_REQUESTS_PER_CONN=1
MAX_CONCURRENT_REQUESTS=1
H2LOAD_M=1
# Apples-to-apples with TQUIC's published bench (2026-05-04):
# tquic_client's bench defaults to --session-file=None / --enable-early-data=false.
# Session ticket reuse here was a config asymmetry IN OUR FAVOR (~99% resumption
# rate vs TQUIC's 0%); disabling it makes short-conn measure the cold-handshake
# hot path TQUIC's published numbers actually represent. Server-side Ticketer
# stays on (TQUIC's tquic_server also issues tickets unconditionally — symmetric).
# SESSION_FILE=/tmp/tquic-session-shortconn.bin
