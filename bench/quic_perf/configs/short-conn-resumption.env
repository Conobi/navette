# Short-connection scenario WITH TLS 1.3 session resumption (production-realism cell).
# Mirrors short-conn.env but enables session-ticket reuse via $SESSION_FILE.
#
# Side-by-side with short-conn.env (the cold/apples-to-apples cell):
#   - short-conn.env:            SESSION_FILE unset → all `Full` handshakes,
#                                matches TQUIC's published bench (which also
#                                runs --session-file=None by default).
#   - short-conn-resumption.env: SESSION_FILE set → bench client persists
#                                tickets across the conn pool → mostly
#                                `Resumed` handshakes (~99% per p2-verdict).
#                                Reflects production workloads where clients
#                                cache and replay tickets.
#
# Use to quantify how much of the 0.49× short-conn gap vs TQUIC is
# production-realism artifact vs real lib-bound CPU work.
MAX_REQUESTS_PER_CONN=1
MAX_CONCURRENT_REQUESTS=1
H2LOAD_M=1
SESSION_FILE=/tmp/tquic-session-shortconn-resume.bin
