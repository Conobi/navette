[
  {
    "id": "c1-1-encode-10-prefix-5",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §C.1.1",
    "description": "Encoding 10 with 5-bit prefix",
    "input": { "value": 10, "prefix_bits": 5 },
    "expected_encode_hex": "0a",
    "expected_decode": { "value": 10, "bytes_consumed": 1 }
  },
  {
    "id": "c1-2-encode-1337-prefix-5",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §C.1.2",
    "description": "Encoding 1337 with 5-bit prefix",
    "input": { "value": 1337, "prefix_bits": 5 },
    "expected_encode_hex": "1f9a0a",
    "expected_decode": { "value": 1337, "bytes_consumed": 3 }
  },
  {
    "id": "c1-3-encode-42-prefix-8",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §C.1.3",
    "description": "Encoding 42 with 8-bit prefix",
    "input": { "value": 42, "prefix_bits": 8 },
    "expected_encode_hex": "2a",
    "expected_decode": { "value": 42, "bytes_consumed": 1 }
  },
  {
    "id": "edge-zero-prefix-5",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §5.1",
    "description": "Encoding 0 with 5-bit prefix",
    "input": { "value": 0, "prefix_bits": 5 },
    "expected_encode_hex": "00",
    "expected_decode": { "value": 0, "bytes_consumed": 1 }
  },
  {
    "id": "edge-max-single-prefix-5",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §5.1",
    "description": "Encoding 30 with 5-bit prefix (max single-byte value)",
    "input": { "value": 30, "prefix_bits": 5 },
    "expected_encode_hex": "1e",
    "expected_decode": { "value": 30, "bytes_consumed": 1 }
  },
  {
    "id": "edge-trigger-multibyte-prefix-5",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §5.1",
    "description": "Encoding 31 with 5-bit prefix (triggers multi-byte)",
    "input": { "value": 31, "prefix_bits": 5 },
    "expected_encode_hex": "1f00",
    "expected_decode": { "value": 31, "bytes_consumed": 2 }
  },
  {
    "id": "edge-max-single-prefix-8",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §5.1",
    "description": "Encoding 255 with 8-bit prefix (max_prefix = 255, triggers multi-byte)",
    "input": { "value": 255, "prefix_bits": 8 },
    "expected_encode_hex": "ff00",
    "expected_decode": { "value": 255, "bytes_consumed": 2 }
  },
  {
    "id": "edge-trigger-multibyte-prefix-8",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §5.1",
    "description": "Encoding 256 with 8-bit prefix (triggers multi-byte for 8-bit)",
    "input": { "value": 256, "prefix_bits": 8 },
    "expected_encode_hex": "ff01",
    "expected_decode": { "value": 256, "bytes_consumed": 2 }
  },
  {
    "id": "overflow-too-many-continuation-bytes",
    "type": "hpack_integer",
    "rfc_section": "RFC 7541 §5.1",
    "description": "Wire with continuation bytes decoding to value > 2^31-1",
    "input": { "wire_hex": "1fffffffff7f", "prefix_bits": 5 },
    "expected_decode": { "error": "integer overflow" }
  }
]
