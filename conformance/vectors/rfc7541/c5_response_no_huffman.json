{
  "id": "c5-response-no-huffman",
  "type": "hpack_story",
  "rfc_section": "RFC 7541 §C.5",
  "description": "Response examples without Huffman coding",
  "cases": [
    {
      "seqno": 0,
      "header_table_size": 256,
      "wire_hex": "4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d",
      "expected_headers": [
        [":status", "302"],
        ["cache-control", "private"],
        ["date", "Mon, 21 Oct 2013 20:13:21 GMT"],
        ["location", "https://www.example.com"]
      ],
      "expected_dynamic_table": [
        ["location", "https://www.example.com"],
        ["date", "Mon, 21 Oct 2013 20:13:21 GMT"],
        ["cache-control", "private"],
        [":status", "302"]
      ],
      "expected_table_size": 222
    },
    {
      "seqno": 1,
      "wire_hex": "4803333037c1c0bf",
      "expected_headers": [
        [":status", "307"],
        ["cache-control", "private"],
        ["date", "Mon, 21 Oct 2013 20:13:21 GMT"],
        ["location", "https://www.example.com"]
      ],
      "expected_dynamic_table": [
        [":status", "307"],
        ["location", "https://www.example.com"],
        ["date", "Mon, 21 Oct 2013 20:13:21 GMT"],
        ["cache-control", "private"]
      ],
      "expected_table_size": 222
    },
    {
      "seqno": 2,
      "wire_hex": "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31",
      "expected_headers": [
        [":status", "200"],
        ["cache-control", "private"],
        ["date", "Mon, 21 Oct 2013 20:13:22 GMT"],
        ["location", "https://www.example.com"],
        ["content-encoding", "gzip"],
        ["set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"]
      ],
      "expected_dynamic_table": [
        ["set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"],
        ["content-encoding", "gzip"],
        ["date", "Mon, 21 Oct 2013 20:13:22 GMT"]
      ],
      "expected_table_size": 215
    }
  ]
}
