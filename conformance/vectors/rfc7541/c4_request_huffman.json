{
  "id": "c4-request-huffman",
  "type": "hpack_story",
  "rfc_section": "RFC 7541 §C.4",
  "description": "Request examples with Huffman coding",
  "cases": [
    {
      "seqno": 0,
      "wire_hex": "828684418cf1e3c2e5f23a6ba0ab90f4ff",
      "expected_headers": [
        [":method", "GET"],
        [":scheme", "http"],
        [":path", "/"],
        [":authority", "www.example.com"]
      ],
      "expected_dynamic_table": [
        [":authority", "www.example.com"]
      ],
      "expected_table_size": 57
    },
    {
      "seqno": 1,
      "wire_hex": "828684be5886a8eb10649cbf",
      "expected_headers": [
        [":method", "GET"],
        [":scheme", "http"],
        [":path", "/"],
        [":authority", "www.example.com"],
        ["cache-control", "no-cache"]
      ],
      "expected_dynamic_table": [
        ["cache-control", "no-cache"],
        [":authority", "www.example.com"]
      ],
      "expected_table_size": 110
    },
    {
      "seqno": 2,
      "wire_hex": "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf",
      "expected_headers": [
        [":method", "GET"],
        [":scheme", "https"],
        [":path", "/index.html"],
        [":authority", "www.example.com"],
        ["custom-key", "custom-value"]
      ],
      "expected_dynamic_table": [
        ["custom-key", "custom-value"],
        ["cache-control", "no-cache"],
        [":authority", "www.example.com"]
      ],
      "expected_table_size": 164
    }
  ]
}
