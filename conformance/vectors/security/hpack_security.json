[
  {
    "id": "hpack-bomb-001",
    "type": "hpack_security",
    "severity": "severe",
    "description": "HPACK bomb: small wire, large decoded headers via indexed references",
    "input": {
      "wire_hex": "",
      "description": "Setup adds 4KB entry via literal-with-indexing, then 20 indexed refs to entry 62 produce ~84798 decoded bytes exceeding 65536 limit"
    },
    "expected": {
      "behavior": "reject",
      "reason": "header list size exceeds maximum"
    }
  },
  {
    "id": "hpack-integer-overflow-001",
    "type": "hpack_security",
    "severity": "severe",
    "description": "Indexed header field with integer overflow (5 continuation bytes of 0xFF)",
    "input": {
      "wire_hex": "ffffffffffff",
      "description": "0xFF starts indexed field with max 7-bit prefix (127), then 5 continuation bytes each adding 127 at shifts 0,7,14,21,28 — exceeds 2^31-1 after 5th byte"
    },
    "expected": {
      "behavior": "reject",
      "reason": "integer overflow"
    }
  },
  {
    "id": "hpack-invalid-huffman-001",
    "type": "hpack_security",
    "severity": "severe",
    "description": "Huffman-encoded value with incomplete code (non-decodable trailing bits)",
    "input": {
      "wire_hex": "0182fff0",
      "description": "Literal without indexing, name_index=1 (:authority), value is Huffman-flagged length=2, data=0xFFF0 — bits form no complete Huffman symbol, padding exceeds 7 bits"
    },
    "expected": {
      "behavior": "reject",
      "reason": "incomplete Huffman code"
    }
  },
  {
    "id": "hpack-invalid-huffman-padding-001",
    "type": "hpack_security",
    "severity": "severe",
    "description": "Huffman-encoded value with invalid padding (non-1 bits in padding)",
    "input": {
      "wire_hex": "018100",
      "description": "Literal without indexing, name_index=1 (:authority), value is Huffman-flagged length=1, data=0x00 — decodes '0' (5 bits) but remaining 3 bits are 000 not 111"
    },
    "expected": {
      "behavior": "reject",
      "reason": "invalid Huffman padding"
    }
  },
  {
    "id": "hpack-invalid-index-001",
    "type": "hpack_security",
    "severity": "severe",
    "description": "Indexed header field referencing index 100 — beyond static table and empty dynamic table",
    "input": {
      "wire_hex": "e4",
      "description": "0xE4 = 1_1100100 = indexed field, index 100; static table only has 61 entries and dynamic table is empty"
    },
    "expected": {
      "behavior": "reject",
      "reason": "invalid index 100"
    }
  },
  {
    "id": "hpack-table-size-exceed-001",
    "type": "hpack_security",
    "severity": "severe",
