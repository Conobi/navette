      "behavior": "reject",
      "reason": "table size update exceeds protocol limit"
    }
  },
  {
    "id": "hpack-truncated-integer-001",
    "type": "hpack_security",
    "severity": "severe",
    "description": "Literal with indexing, name index starts multi-byte integer but wire is truncated",
    "input": {
      "wire_hex": "7f",
      "description": "0x7F = literal with incremental indexing, name_index prefix=63 (6-bit max); needs continuation byte but wire ends"
    },
    "expected": {
      "behavior": "reject",
      "reason": "truncated: incomplete integer"
    }
  },
  {
    "id": "hpack-table-resize-clean-001",
    "type": "hpack_security",
